{
  "version": "0.3.0",
  "dependencias": {
    "expo": "~54.0.36",
    "expo-application": "~7.0.8",
    "expo-asset": "~12.0.13",
    "expo-audio": "~1.1.1",
    "expo-battery": "~10.0.8",
    "expo-dev-client": "~6.0.21",
    "expo-file-system": "~19.0.23",
    "expo-image-manipulator": "~14.0.8",
    "expo-image-picker": "~17.0.11",
    "expo-location": "~19.0.8",
    "expo-notifications": "~0.32.17",
    "expo-secure-store": "~15.0.8",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "expo-task-manager": "~14.0.9",
    "expo-updates": "~29.0.19",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-webview": "13.15.0"
  },
  "plugins": [
    [
      "expo-splash-screen",
      {
        "backgroundColor": "#0A1A2E"
      }
    ],
    [
      "expo-location",
      {
        "isAndroidBackgroundLocationEnabled": true,
        "isAndroidForegroundServiceEnabled": true,
        "locationAlwaysAndWhenInUsePermission": "Control de ruta usa tu ubicación durante el turno, también con la pantalla apagada, para calcular la brecha con las otras combis de tu ruta."
      }
    ],
    [
      "expo-image-picker",
      {
        "photosPermission": "Control de ruta necesita acceso a tus fotos para que puedas mandar una que ya sacaste al chat de la ruta.",
        "cameraPermission": "Control de ruta usa la cámara para que puedas mandarle una foto a Despacho: un desperfecto, un choque, un control."
      }
    ]
  ],
  "android": {
    "package": "com.microstempo.chofer",
    "allowBackup": false,
    "versionCode": 6,
    "adaptiveIcon": {
      "foregroundImage": "./assets/adaptive-icon.png",
      "backgroundColor": "#2580CF"
    },
    "edgeToEdgeEnabled": true,
    "permissions": [
      "ACCESS_COARSE_LOCATION",
      "ACCESS_FINE_LOCATION",
      "ACCESS_BACKGROUND_LOCATION",
      "FOREGROUND_SERVICE",
      "FOREGROUND_SERVICE_LOCATION",
      "POST_NOTIFICATIONS",
      "WAKE_LOCK",
      "CAMERA",
      "android.permission.ACCESS_COARSE_LOCATION",
      "android.permission.ACCESS_FINE_LOCATION",
      "android.permission.ACCESS_BACKGROUND_LOCATION",
      "android.permission.FOREGROUND_SERVICE",
      "android.permission.FOREGROUND_SERVICE_LOCATION"
    ]
  },
  "newArchEnabled": true,
  "scheme": null,
  "ios": null
}
